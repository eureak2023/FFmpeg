#include "ffplay_res.h"

1 ICON "fftools/ffplay.ico"

/* RIFE v4.6 model embedded into the executable. Paths are relative to the
 * build working directory (the FFmpeg source root), like the ICON above; the
 * model is vendored outside the repo at ../bin/rife-v4.6/ alongside ncnn and
 * SDL2. */
IDR_RIFE_FLOWNET_PARAM RCDATA "../bin/rife-v4.6/flownet.param"
IDR_RIFE_FLOWNET_BIN   RCDATA "../bin/rife-v4.6/flownet.bin"

/* Bundled UI font (Noto Sans KR) and the subtitle font (HMFMPYUN / "Pyunji R").
 * Vendored in the FFmpeg source root. */
IDR_FONT_NOTOSANS      RCDATA "NotoSansKR-Regular.ttf"
IDR_FONT_HMFMPYUN      RCDATA "HMFMPYUN.TTF"
